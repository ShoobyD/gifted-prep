# Copy to .dev.vars (gitignored) for local dev with `npm run dev:api`.
# In production, set both as encrypted variables in the Cloudflare Pages dashboard.
# The admin family's password, until it sets one of its own in the app.
FAMILY_PASSWORD="choose-a-password"
# Signs logins and hashes family passwords: changing it voids every family's password.
SESSION_SECRET="a-long-random-string"
